velocidade = float(input('Qual a velocidade do veículo? ' ))
multa = (velocidade - 80) * 7
if velocidade > 80:
    print('Você está acima da velocidade máxima permitida que é 80km/h e será multado em R${:.2f}.'.format(multa))
else:
    print('Você está dentro do limite de velocidade. Tenha uma boa viagem!')
